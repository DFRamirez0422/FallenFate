%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1cfbfad8f8639994ca9ec4d4fb19464e, type: 3}
  m_Name: Act1_06_Oceanfront_Dorothy
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 5
    text: Oh... You came back.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: I was wondering when someone would.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: They always say they'll meet you here.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 0
    text: '*Shift slightly.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 5
    text: ...Do you live here?
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 0
    text: '*Dorothy smiles faintly.'
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 5
    text: Live?
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: No, dear. I'm just waiting.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: I've been waiting a long time.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 5
    text: ...Waiting for who?
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 2
    text: '*Dorothy pauses. The ocean churns softly below.'
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 3
    text: For him.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 3
    text: He said he'd come back for me. Said this place would still be here.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: And so would I.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 0
    text: '*Look toward the prison in the distance.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 5
    text: Did he go inside?
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 0
    text: '*Dorothy lets out a quiet, amused breath.'
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: Oh no. He left.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 3
    text: People always leave.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 3
    text: They just forget to say goodbye.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: ...Then why are you still here?
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 0
    text: '*Dorothy turns her head slightly. Her eyes are distant, unfocused.'
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: Because if I go...
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 3
    text: ...then it means he isn't coming back.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 3
    text: And I don't think I'm ready for that.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: I'm looking for someone. She asked me to meet her here.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 0
    text: '*Dorothy nods slowly.'
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: They all do.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: This place is very good at holding promises.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: Even after the people who made them are gone.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 0
    text: '*Clench fist.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: She's waiting for me.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 0
    text: '*Dorothy smiles again. Sad. Gentle.'
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: ...I hope so.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: It's easier when you believe that.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 0
    text: '*Dorothy turns back toward the ocean.'
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: If you're going inside...
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: ...you'll need a key.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: There's a small shed down the path. Security used to keep things there.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: I can't walk that far anymore.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 0
    text: '*Nod.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: Thank you.
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 0
    text: '*Dorothy doesn''t respond. Only the ocean answers.'
  options: []
  requiredNPCs: []
