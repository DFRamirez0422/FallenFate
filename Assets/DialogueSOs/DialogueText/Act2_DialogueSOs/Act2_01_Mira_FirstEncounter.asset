  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1cfbfad8f8639994ca9ec4d4fb19464e, type: 3}
  m_Name: Act2_01_Mira_FirstEncounter
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 5
    text: "\u2026Elena?"
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: "No. But whoever she is\u2026 you sounded relieved when you said her name."
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 2
    text: "Sorry. I thought you were someone else. I\u2019m Dante."
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 2
    text: "Mira. I don\u2019t mind\u2026 it\u2019s nice to hear someone say a name
      like it matters."
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: "It does. She\u2019s the reason I\u2019m here. She asked me to come."
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 2
    text: "She\u2019s lucky. Not everyone would go this far. I don\u2019t think anyone\u2019s
      ever looked for me like that\u2026 and I don\u2019t think he would. You would
      though, wouldn\u2019t you?"
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 2
    text: "That must feel nice\u2026 to be wanted like that. Just don\u2019t disappear
      chasing someone who already has. Stay safe in there."
  options: []
  requiredNPCs: []
  actionOnDialogueEnd: 0
  sceneName: 
  nextDialogue: {fileID: 0}
