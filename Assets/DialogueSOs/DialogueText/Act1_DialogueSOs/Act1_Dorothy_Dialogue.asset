MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1cfbfad8f8639994ca9ec4d4fb19464e, type: 3}
  m_Name: Act1_Dorothy_Dialogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 2
    text: "Oh\u2026 you came back. I was wondering when someone would. They always
      say they\u2019ll meet you here\u2026 but they never do."
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 5
    text: Do you live here?
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 1
    text: "Live? No, dear. I\u2019m just waiting. I\u2019ve been waiting a long time."
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 5
    text: Waiting for who?
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 2
    text: "For him. He said he\u2019d come back\u2026 that this place would still
      be here. And so would I. But he left. People always leave\u2026 they just forget
      to say goodbye."
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: Then why are you still here?
  - speaker: {fileID: 11400000, guid: a0e7b794e53a5a44f9faa8aa9147a5a8, type: 2}
    emotion: 2
    text: "Because if I go\u2026 then it means he isn\u2019t coming back. And I\u2019m
      not ready for that. If you\u2019re going inside, you\u2019ll need a key. There\u2019s
      a shed down the path. I can\u2019t walk that far anymore."
  options: []
  requiredNPCs: []
  actionOnDialogueEnd: 0
  sceneName: 
  nextDialogue: {fileID: 0}
