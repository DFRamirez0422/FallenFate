  m_Script: {fileID: 11500000, guid: 1cfbfad8f8639994ca9ec4d4fb19464e, type: 3}
  m_Name: Good Ending
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 2
    text: "She\u2019s already gone\u2026 and she already forgave me. I\u2019m the
      only one still holding on\u2026 still trying to go back to something that\u2019s
      already over.\r\n"
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 2
    text: "\u2026I don\u2019t need to carry this anymore. Not the guilt\u2026 not
      the silence\u2026 not the goodbye I was too afraid to say.\r\nElena\u2026\r"
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 2
    text: "\u2026I love you."
  options: []
  requiredNPCs: []
  actionOnDialogueEnd: 2
  sceneName: Credits
  nextDialogue: {fileID: 0}
