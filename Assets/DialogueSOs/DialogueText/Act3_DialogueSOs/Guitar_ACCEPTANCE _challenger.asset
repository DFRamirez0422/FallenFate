  lines:
  - speaker: {fileID: 11400000, guid: cc664bc6b87a77b49b60f1cf7e3e5b97, type: 2}
    emotion: 1
    text: "She\u2019s not here.\r"
  - speaker: {fileID: 11400000, guid: cc664bc6b87a77b49b60f1cf7e3e5b97, type: 2}
    emotion: 1
    text: "She already forgave you.\r\r\r"
  - speaker: {fileID: 11400000, guid: ca15e605cd979794c8bca519607e73a7, type: 2}
    emotion: 3
    text: "\u2026Then why am I here?\r"
  - speaker: {fileID: 11400000, guid: cc664bc6b87a77b49b60f1cf7e3e5b97, type: 2}
    emotion: 1
    text: "You won\u2019t forgive yourself.\r\r\r"
  - speaker: {fileID: 11400000, guid: cc664bc6b87a77b49b60f1cf7e3e5b97, type: 2}
    emotion: 1
    text: "Let go... Play.\r\n\r\r\r"
