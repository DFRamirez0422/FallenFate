  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1cfbfad8f8639994ca9ec4d4fb19464e, type: 3}
  m_Name: Act3_01_David_FirstEncounter
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: "Hey! You can\u2019t stay here\u2026 it\u2019s not safe. Are you alright?"
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    emotion: 1
    text: "It\u2019s quiet\u2026 makes it easier to think. Hopefully I can remember
      her."
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 5
    text: "\u2026Who are you?"
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    emotion: 3
    text: "David. At least I was\u2026 when she was still around. Now I don\u2019t
      know who I am anymore."
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: "Have you seen a girl? Dark hair\u2026 she\u2019s everything."
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    emotion: 7
    text: "\u2026She\u2019s not here. Get used to the disappointment. My love left
      too\u2026 but she never came back. So I erased her. Everything. The pain went
      away\u2026 but so did everything else."
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    emotion: 3
    text: "And now I\u2019d give anything to remember her\u2026"
  options: []
  requiredNPCs: []
