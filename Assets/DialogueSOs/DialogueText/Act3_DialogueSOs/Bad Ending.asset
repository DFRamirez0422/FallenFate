  m_Script: {fileID: 11500000, guid: 1cfbfad8f8639994ca9ec4d4fb19464e, type: 3}
  m_Name: Bad Ending
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 2
    text: "If I let this go\u2026 Then that\u2019s it. There\u2019s nothing left
      of us. Nothing to hold onto\u2026 Nothing to go back to. I can\u2019t lose
      her like that again."
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 2
    text: "\u2026I\u2019m not ready. Not yet. If I stay here\u2026 if I keep trying\u2026
      maybe this time I can be there for her. Maybe this time I won\u2019t have to
      say goodbye.\r"
