  m_Script: {fileID: 11500000, guid: 1cfbfad8f8639994ca9ec4d4fb19464e, type: 3}
  m_Name: Bad Ending
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 2
    text: If I let this go, let her go... There won't be nothing left of us. I can't
      lose her again...
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 2
    text: I'm not ready... If I stay, maybe this time I can be there for her... Maybe
      I won't have to say goodbye.
