%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1cfbfad8f8639994ca9ec4d4fb19464e, type: 3}
  m_Name: Act3_01_David_FirstEncounter
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: Hey!
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: '*No response.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: Hey, you can't stay here.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: It's not safe. Are you alright?
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: '*Long pause.'
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: It's quiet.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: ...What?
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: In here.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: It's quiet in here, makes it easier to think.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: Hopefully I can remember.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: '*...'
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: '*Pause.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: Remember what?
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: Her.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: '*Silence.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: ...Who are you?
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: David.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: At least I was, when she was still around.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: Now? I don't know who I am anymore.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: '*Small pause.'
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: You?
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: Dante.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: '*Silence.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: Have you seen a girl?
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: Dark hair. Beautiful.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: She's-
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: '*Dante struggles, chokes on words.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: She's everything.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: '*Faint, tired laugh from David.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: What?
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: She's not here.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: You don't know that.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: I do.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: '*Silence.'
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: Get used to the disappointment.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: Shut up.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: My love left a long time ago too.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: But she never came back.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: '*Pause.'
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: So I erased her.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: Photos. Letters. Places. Songs.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: Everything that reminded me of her, all gone.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: '*Silence.'
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: When the pain got too heavy...
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: I got rid of it all.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: Every memory, every argument, every kiss.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: All of it, gone.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: '*Long pause.'
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: The pain went away...
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: Everything went away...
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: Now, I don't feel anything.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: '*Silence.'
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: And I would give anything to remember her.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: Her face.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: Her smile.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: What it felt like to love her.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: What it felt like to be loved by her.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: '*Long pause.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: That's not going to happen to me.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: Same thing I told myself.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: '*Silence.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: I'm not going to forget her.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: I'm not going to erase her.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: She means everything to me.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: And what will you do if you can't find her?
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: JUST SHUT UP!
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: She's here.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    text: I just haven't found her yet.
  - speaker: {fileID: 11400000, guid: 9cd5c2aa108e7ef488437013a6b31f14, type: 2}
    text: ...I hope you're right.
  options: []
  requiredNPCs: []
