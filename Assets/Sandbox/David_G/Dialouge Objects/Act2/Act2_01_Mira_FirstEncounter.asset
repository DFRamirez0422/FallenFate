%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1cfbfad8f8639994ca9ec4d4fb19464e, type: 3}
  m_Name: Act2_01_Mira_FirstEncounter
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 5
    text: ...Elena?
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: No.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: But whoever she is... you sounded relieved when you said her name.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: Sorry. I didn't mean to-
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 3
    text: I thought you were someone else.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: I'm Dante.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: Mira.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: It's okay. I don't mind being mistaken for someone important.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: It's nice to meet someone who says a name like that.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 5
    text: Like what?
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: Like it matters.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 0
    text: '*Small pause.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: It does. When I say her name, it means something.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: She's the reason I'm here.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: She's lucky.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: You came all this way.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: She asked me to.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: She wrote me a letter, asking me to meet her here.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: Still.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: Not everyone would.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 2
    text: '*Small pause.'
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 3
    text: I don't think anyone's ever looked for me like that.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 5
    text: ...You're here waiting for someone?
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 3
    text: Yeah.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 3
    text: But I don't think he'd cross an ocean for me.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 2
    text: '*Silence.'
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: You would, though...
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 5
    text: Wouldn't you?
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: Um... yeah.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: Of course, I would do anything for Elena.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 3
    text: That must feel nice.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 3
    text: To be wanted that much.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 2
    text: '*Another soft pause.'
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 3
    text: I would never leave someone who loved me like that.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 0
    text: '*Small pause.'
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 3
    text: She had her reasons.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: I'm sure she did.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 0
    text: '*Another small pause.'
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: You make it sound easy.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: Loving someone that much.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: It is.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 3
    text: ...must be nice.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 3
    text: To know someone would fight for you like that.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 3
    text: If you get tired of searching-
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: I won't, I'm not giving up on her.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 3
    text: I know. Just... don't disappear chasing someone who already has.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 1
    text: Stay safe in there, Dante.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: You too.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 3
    text: I will.
  - speaker: {fileID: 11400000, guid: f68665150fc747b48966b2571937e99e, type: 2}
    emotion: 3
    text: I'm not going anywhere.
  options: []
  requiredNPCs: []
