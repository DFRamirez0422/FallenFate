  lines:
  - speaker: {fileID: 11400000, guid: ca15e605cd979794c8bca519607e73a7, type: 2}
    text: "\"Locked...?\""
  - speaker: {fileID: 11400000, guid: ca15e605cd979794c8bca519607e73a7, type: 2}
    text: "\"No. She wouldn't ask me to come all this way for nothing.\""
  - speaker: {fileID: 11400000, guid: ca15e605cd979794c8bca519607e73a7, type: 2}
    text: "\"There has to be another way in. I might find a back entrance through the woods.\""
