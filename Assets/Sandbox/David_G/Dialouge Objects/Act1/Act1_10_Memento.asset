  m_Script: {fileID: 11500000, guid: 1cfbfad8f8639994ca9ec4d4fb19464e, type: 3}
  m_Name: Act1_10_Memento
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: ca15e605cd979794c8bca519607e73a7, type: 2}
    text: "\"...You still had this?\""
  - speaker: {fileID: 11400000, guid: ca15e605cd979794c8bca519607e73a7, type: 2}
    text: "\"I thought you took it with you.\""
  - speaker: {fileID: 11400000, guid: ca15e605cd979794c8bca519607e73a7, type: 2}
    text: "\"...You wouldn't leave this behind. Not if you were really gone.\""
  - speaker: {fileID: 11400000, guid: ca15e605cd979794c8bca519607e73a7, type: 2}
    text: "\"I'll play it for you again. You'll remember. Then you'll want to stay.\""
  options: []
  requiredNPCs: []
