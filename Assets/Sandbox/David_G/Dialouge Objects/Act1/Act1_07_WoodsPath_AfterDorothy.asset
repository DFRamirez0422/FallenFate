  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1cfbfad8f8639994ca9ec4d4fb19464e, type: 3}
  m_Name: Act1_07_WoodsPath_AfterDorothy
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: She might not even be here. This place... it doesn't make sense. People
      don't just wait forever.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: ...But she asked me to come. She wrote to me. She wouldn't do that if she
      was really gone.
  - speaker: {fileID: 11400000, guid: 7ce02c1f8c657064e91da607aebe315a, type: 2}
    emotion: 1
    text: I can feel it. I'm not wrong. I just have to keep going... before I start
      thinking too much.
  options: []
  requiredNPCs: []
