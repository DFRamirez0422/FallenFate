  lines:
  - speaker: {fileID: 11400000, guid: 4ed686bae3d45c34f9bc8fe1264247da, type: 2}
    text: Have you seen my girlfriend Alena around?
  - speaker: {fileID: 11400000, guid: 47eadc10d5e231b44934775fd1e4e94e, type: 2}
    text: 'Never seen her before, maybe check the shed down the path. '
  - speaker: {fileID: 11400000, guid: 7700d8245df57ad4f8ae7161b642d714, type: 2}
    text: Thank you.
